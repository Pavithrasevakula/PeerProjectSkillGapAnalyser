# Dependencies
node_modules/
**/node_modules/

# Build outputs
frontend/dist/
frontend/build/
functions/lib/

# Environment variables (SENSITIVE - Never commit!)
# Ignore every .env variant at any depth (.env, .env.local, .env.development.local,
# .env.production.local, .env.test.local, ...) but keep the documented template.
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credentials and keys
service-account-key.json
**/service-account-key.json
*-service-account*.json
serviceAccountKey*.json
*.pem
*.key
.runtimeconfig.json
**/.runtimeconfig.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Firebase
.firebase/
.firebaserc.local


# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
~$*.docx
~$*.xlsx

# Markdown notes, reports and drafts stay local. Files already tracked (the docs listed in
# README.md) keep being tracked; only new .md files are ignored.
*.md
!README.md

# Test output
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
