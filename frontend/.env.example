# Firebase web app configuration (Firebase console > Project settings > Your apps > SDK setup).
# Copy this file to `.env` (local) or set the same variables in your build environment.
# These are public client identifiers, not secrets, but keep real values out of git.

# --- Required ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_app_id_here

# --- Optional ---------------------------------------------------------------
# Needed for profile video uploads (Firebase Storage).
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud Functions region (must match the region the functions are deployed to).
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" to use the local Firebase emulators (placeholder config is then allowed).
# Never enable this for a production build.
VITE_USE_EMULATORS=false
